# Database (Ambil dari Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# JWT (Gunakan string random 32+ karakter di produksi)
JWT_SECRET="ganti-dengan-secret-yang-sangat-kuat-dan-panjang"
JWT_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=production

# Frontend URL (Tanpa trailing slash, contoh: https://mbg.vercel.app)
FRONTEND_URL="http://localhost:3000"

# Supabase Storage
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
